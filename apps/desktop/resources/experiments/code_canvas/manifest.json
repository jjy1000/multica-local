{
  "apiVersion": "multica.dev/experiment/v1",
  "kind": "Experiment",
  "metadata": {
    "name": "code_canvas",
    "flag": "code_canvas",
    "title": { "en": "Code Canvas", "zh": "代码画布" },
    "description": {
      "en": "Local code-rendering lab: a stdlib-only subprocess that turns code snippets into self-contained, syntax-highlighted HTML canvas views via POST /render. Off by default.",
      "zh": "本地代码渲染实验室：stdlib-only 子进程通过 POST /render 把代码片段渲染成自包含、带语法高亮的 HTML 画布视图。默认关闭。"
    },
    "default_enabled": false
  },
  "spec": {
    "workspace": {
      "reserved_slug": "code-canvas",
      "name": "Code Canvas 实验室",
      "description": "Code Canvas lab workspace — local stdlib-only code rendering service."
    },
    "capabilities": {
      "skills": ["multica-code-canvas"],
      "agents": [],
      "squads": [],
      "mcp_servers": [],
      "permissions": ["agent:invoke"]
    },
    "entry_points": {
      "sidebar": [
        { "key": "code_canvas", "label_key": "experimental_code_canvas", "route": "/experimental/code-canvas" }
      ],
      "settings": { "route": "/experimental/code-canvas" }
    },
    "runtime": {
      "kind": "subprocess",
      "binary": "code-canvas/run.sh",
      "args": [],
      "health_path": "/health",
      "ready_timeout_ms": 10000,
      "stop_grace_ms": 5000,
      "on_ready": "registerUpstream",
      "on_stop": "unregisterUpstream",
      "on_missing": "service not bundled — drop the binary into apps/desktop/vendor/code-canvas/ and re-run bundle-cli"
    },
    "surface": {
      "proxy_prefix": "/experimental/code-canvas",
      "loopback_service": "code_canvas"
    },
    "resources": {
      "installable": false,
      "lockable_resources": [],
      "install_handler": ""
    },
    "safety": {
      "init_timeout_ms": 10000,
      "burst": { "threshold": 3, "window_seconds": 60 },
      "panic_recover": true,
      "ip_allowlist": ["127.0.0.0/8"]
    },
    "graduation": {
      "promote_to": "features/code_canvas",
      "auto_disable_after": 0
    }
  }
}
