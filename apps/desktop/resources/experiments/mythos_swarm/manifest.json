{
  "apiVersion": "multica.dev/experiment/v1",
  "kind": "Experiment",
  "metadata": {
    "name": "mythos_swarm",
    "flag": "mythos_swarm",
    "title": { "en": "OpenMythos (Outer Loop)", "zh": "OpenMythos 外循环" },
    "description": {
      "en": "OpenMythos outer loop: bind it to an issue together with a target agent or squad — the swarm plans, iterates to convergence, and distills a strategy, then hands it to the assignee to execute. Standalone runs are retired. Off by default.",
      "zh": "OpenMythos 外循环:与某个承办 agent/团队搭配绑定到 issue——蜂群先规划、迭代收敛并蒸馏策略,再交给承办者执行。独立运行已停用。默认关闭。"
    },
    "default_enabled": false
  },
  "spec": {
    "workspace": {
      "reserved_slug": "mythos-swarm",
      "name": "Mythos Swarm 实验室",
      "description": "Mythos Swarm topology workspace."
    },
    "capabilities": {
      "skills": ["multica-mythos"],
      "agents": ["mythos_prelude", "mythos_loop_researcher", "mythos_loop_coder", "mythos_loop_analyst", "mythos_coda"],
      "squads": ["mythos-swarm"],
      "mcp_servers": [],
      "permissions": ["issue:read", "issue:write", "agent:invoke"]
    },
    "entry_points": {
      "sidebar": [
        { "key": "mythos_swarm", "label_key": "experimental_mythos", "route": "/experimental/mythos" }
      ]
    },
    "runtime": { "kind": "headless" },
    "resources": {
      "installable": true,
      "lockable_resources": ["workspace", "skill", "agent", "squad", "member"],
      "install_handler": "mythos_install"
    },
    "safety": {
      "init_timeout_ms": 30000,
      "burst": { "threshold": 3, "window_seconds": 60 },
      "panic_recover": true,
      "ip_allowlist": ["127.0.0.0/8"]
    }
  }
}
