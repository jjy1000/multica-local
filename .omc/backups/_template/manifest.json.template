{
  "_comment": "Backup manifest schema. Every backup directory at .omc/backups/<TS>/<reason>/ must contain a manifest.json with these fields. See ../README.md for conventions.",

  "schema_version": 1,
  "created_at": "ISO-8601 UTC, e.g. 2026-08-11T14:30:00Z",
  "reason": "human-readable slug, e.g. '0.5.15-ship', 'schema-migration-238', 'epic-rewrite-issue-list'",
  "trigger": "release | major-refactor | schema-migration | data-shape | manual",

  "git": {
    "branch": "current branch at backup time",
    "head_commit": "full SHA of HEAD",
    "base_commit": "optional — base commit if backup is for a delta (e.g. release PR merge base)",
    "dirty": "boolean — was working tree dirty at backup time?",
    "status_snapshot": "output of `git status --short` captured at backup time"
  },

  "diff": {
    "patch_file": "diff.patch (relative to this dir)",
    "files_changed": ["path1", "path2", "..."],
    "insertions": 0,
    "deletions": 0,
    "stat": "output of `git diff --stat` captured at backup time"
  },

  "scope": {
    "files_total": "count of files in files_changed",
    "touches_schema": "boolean — any migration / *.sql change?",
    "touches_data": "boolean — any destructive data path? (P0 invariant)",
    "ships_to_desktop": "boolean — does this need the desktop ship chain?"
  },

  "notes_md": "optional notes.md with ship context / blockers / decision rationale",

  "verification": {
    "typecheck_passed": "boolean",
    "go_test_passed": "boolean",
    "manual_smoke_passed": "boolean",
    "evidence": "optional path to .omc/release-notes-<ver>.md or test log"
  },

  "retention": {
    "expires_at": "ISO date — created_at + 90 days, then auto-eligible for archive",
    "archive_after_days": 90
  }
}
